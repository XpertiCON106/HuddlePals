<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the generated Info.plist (GENERATE_INFOPLIST_FILE).
	     Registers the vault:// scheme for shareable invite links. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.vaultapp.Vault.invites</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>vault</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
