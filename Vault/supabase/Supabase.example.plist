<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Copy this file to Vault/Vault/Supabase.plist and fill in both
	     values from your Supabase project (Dashboard → Settings → API).
	     Without a filled-in Supabase.plist the app runs in mock mode.
	     The anon key is publishable — RLS is what protects the data. -->
	<key>SUPABASE_URL</key>
	<string>https://YOUR-PROJECT.supabase.co</string>
	<key>SUPABASE_ANON_KEY</key>
	<string>YOUR-ANON-KEY</string>
</dict>
</plist>
